<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>gov.nist.hit.iz</groupId>
	<artifactId>hit-iz-tool</artifactId>
	<version>1.4.2-SNAPSHOT</version>
	<name>hit-iz-tool</name>
	<description>Immunization tool</description>
	<packaging>pom</packaging>
	<modules>
		<module>hit-iz-resource</module>
		<module>hit-iz-domain</module>
		<module>hit-iz-repo</module>
		<module>hit-iz-service</module>
		<module>hit-iz-ws</module>
		<module>hit-iz-web</module>
	</modules>

	<properties>
		<spring.version>4.3.8.RELEASE</spring.version>
		<hithl7v2.version>1.1.1-SNAPSHOT</hithl7v2.version>
		<hitcore.version>1.1.2-SNAPSHOT</hitcore.version>
		<unifiedreport.version>1.1.1-SNAPSHOT</unifiedreport.version>
		<hl7v2.version>1.7.3</hl7v2.version>
		<log4j.version>2.25.4</log4j.version>
		
		<!-- <hitcore.version>1.0.28</hitcore.version> -->
<!--		<core.version>1.0.48</core.version>-->
		<java.version>1.8</java.version>		
		
	</properties>

	<!-- Pin the framework chain to what the 1.9.14 release shipped with. The
	     hit-core-hl7v2 1.1.1-SNAPSHOT pom on Nexus still points at hit-core
	     1.1.0 and the older validation engine, and a plain build would pick
	     those up and lose the framework fixes the deployed tool relies on. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-domain</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-repo</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-service</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-transport</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-api</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-auth-domain</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-auth-repo</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.core</groupId>
				<artifactId>hit-core-auth-service</artifactId>
				<version>${hitcore.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.healthcare.hl7.v2.unifiedreport</groupId>
				<artifactId>report</artifactId>
				<version>${unifiedreport.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.healthcare.hl7.v2.unifiedreport</groupId>
				<artifactId>report-filter</artifactId>
				<version>${unifiedreport.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.healthcare.hl7.v2.unifiedreport</groupId>
				<artifactId>validation-proxy</artifactId>
				<version>${unifiedreport.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.healthcare.hl7.v2.unifiedreport</groupId>
				<artifactId>xml-schema</artifactId>
				<version>${unifiedreport.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit.hl7</groupId>
				<artifactId>xml-verification</artifactId>
				<version>1.6.5-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.healthcare</groupId>
				<artifactId>schematronValidation</artifactId>
				<version>1.1-SNAPSHOT</version>
			</dependency>
			<dependency>
				<groupId>gov.nist</groupId>
				<artifactId>hl7-v2-parser</artifactId>
				<version>${hl7v2.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist</groupId>
				<artifactId>hl7-v2-profile</artifactId>
				<version>${hl7v2.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist</groupId>
				<artifactId>hl7-v2-validation</artifactId>
				<version>${hl7v2.version}</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hit</groupId>
				<artifactId>hl7-v2-schemas</artifactId>
				<version>1.7.2</version>
			</dependency>
			<dependency>
				<groupId>gov.nist.hl7.v2.validation</groupId>
				<artifactId>hl7-v2-validation-utils</artifactId>
				<version>1.1.0</version>
			</dependency>
			<dependency>
				<groupId>org.apache.logging.log4j</groupId>
				<artifactId>log4j-api</artifactId>
				<version>${log4j.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.logging.log4j</groupId>
				<artifactId>log4j-core</artifactId>
				<version>${log4j.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<dependency>
			<groupId>gov.nist.hit.core.hl7v2</groupId>
			<artifactId>hit-core-hl7v2-service</artifactId>
			<version>${hithl7v2.version}</version>			
		</dependency>
		
		<dependency>
			<groupId>javax.xml.ws</groupId>
			<artifactId>jaxws-api</artifactId>
			<version>2.3.1</version>
		</dependency>
		<dependency>
			<groupId>com.sun.xml.messaging.saaj</groupId>
			<artifactId>saaj-impl</artifactId>
			<version>1.5.1</version>
		</dependency>
			  
	<dependency>
        <groupId>org.glassfish.metro</groupId>
        <artifactId>webservices-rt</artifactId>
        <version>2.4.4</version>
    </dependency>

    <dependency>
        <groupId>org.glassfish.metro</groupId>
        <artifactId>webservices-api</artifactId>
        <version>2.4.4</version>
    </dependency>
			
	</dependencies>



	<build>
		<pluginManagement>
			<plugins>


				<!-- plugin to handle compile version -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>2.5.1</version>
					<configuration>
						<source>${java.version}</source>
						<target>${java.version}</target>
					</configuration>
				</plugin>

				<plugin>
					<artifactId>maven-eclipse-plugin</artifactId>
					<version>2.9</version>
					<configuration>
						<additionalProjectnatures>
							<projectnature>org.springframework.ide.eclipse.core.springnature</projectnature>
						</additionalProjectnatures>
						<additionalBuildcommands>
							<buildcommand>org.springframework.ide.eclipse.core.springbuilder</buildcommand>
						</additionalBuildcommands>
						<downloadSources>true</downloadSources>
						<downloadJavadocs>true</downloadJavadocs>
					</configuration>
				</plugin>
				<plugin>
					<artifactId>maven-release-plugin</artifactId>
					<version>2.5.3</version>
					<configuration>
						<autoVersionSubmodules>true</autoVersionSubmodules>
						<releaseProfiles>release</releaseProfiles>
					</configuration>
					<dependencies>
						<dependency>
							<groupId>org.apache.maven.scm</groupId>
							<artifactId>maven-scm-api</artifactId>
							<version>1.9.2</version>
						</dependency>
						<dependency>
							<groupId>org.apache.maven.scm</groupId>
							<artifactId>maven-scm-provider-gitexe</artifactId>
							<version>1.9.2</version>
						</dependency>
					</dependencies>
				</plugin>

				<!--This plugin's configuration is used to store Eclipse m2e settings only. It has no influence on the Maven build itself.-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											org.apache.maven.plugins
										</groupId>
										<artifactId>
											maven-compiler-plugin
										</artifactId>
										<versionRange>
											[2.5.1,)
										</versionRange>
										<goals>
											<goal>testCompile</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- HIT artifacts are hosted on Valitheus Nexus (not Maven Central). -->
	<repositories>
		<repository>
			<id>valitheus-public</id>
			<url>https://nexus.valitheus.com/repository/public/</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>true</enabled></snapshots>
		</repository>
		<repository>
			<id>valitheus-releases</id>
			<url>https://nexus.valitheus.com/repository/releases/</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>false</enabled></snapshots>
		</repository>
		<repository>
			<id>valitheus-snapshots</id>
			<url>https://nexus.valitheus.com/repository/snapshots/</url>
			<releases><enabled>false</enabled></releases>
			<snapshots><enabled>true</enabled></snapshots>
		</repository>
	</repositories>

	<distributionManagement>
		<repository>
			<id>releases</id>
			<url>https://nexus.valitheus.com/repository/releases/</url>
		</repository>
		<snapshotRepository>
			<id>snapshots</id>
			<name>Internal Snapshots</name>
			<url>https://nexus.valitheus.com/repository/snapshots/</url>
		</snapshotRepository>
	</distributionManagement>
	<scm>
		<connection>scm:git:https://github.com/prometheuscomputing/hit-iz-himss-hid.git</connection>
		<url>scm:git:https://github.com/prometheuscomputing/hit-iz-himss-hid.git</url>
		<developerConnection>scm:git:https://github.com/prometheuscomputing/hit-iz-himss-hid.git</developerConnection>
     </scm>
  
</project>